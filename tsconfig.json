{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "jsx": "react-jsx",
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "sourceMap": true,
    "declaration": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "**/node_modules/*"],
  "include": ["./*.ts"]
}
